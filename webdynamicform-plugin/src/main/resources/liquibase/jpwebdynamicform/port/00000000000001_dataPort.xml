    <changeSet id="00000000000001_jpwebdynamicform_dataPort_config" author="entando" context="production">

        <preConditions onFail="MARK_RAN">
            <!-- Use uppercase table name to avoid MySQL issue -->
            <sqlCheck expectedResult="0">
                SELECT COUNT(*)
                FROM SYSCONFIG
                WHERE item = 'jpwebdynamicform_messageTypes'
            </sqlCheck>
        </preConditions>

        <insert tableName="sysconfig">
            <column name="version" value="production"/>
            <column name="item" value="jpwebdynamicform_messageTypes"/>
            <column name="descr" value="Web Dynamic Form - Message type definition"/>
            <column name="config"><![CDATA[<messagetypes/>]]></column>
        </insert>

        <insert tableName="sysconfig">
            <column name="version" value="production"/>
            <column name="item" value="jpwebdynamicform_messageNotifierConfig"/>
            <column name="descr" value="Web Dynamic Form - Configuration of notify service"/>
            <column name="config"><![CDATA[<messagetypes/>]]></column>
        </insert>

    </changeSet>

