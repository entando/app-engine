<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:p="http://www.springframework.org/schema/p"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean name="jpwebdynamicformMessageManagerCache" class="java.util.concurrent.ConcurrentHashMap"/>

    <bean id="jpwebdynamicformExternalCachesContainer"
          class="org.entando.entando.aps.system.services.cache.ExternalCachesContainer">
        <property name="caches">
            <set>
                <bean class="org.entando.entando.aps.system.services.cache.CustomConcurrentMapCacheFactoryBean"
                      p:name="Entando_jpwebdynamicformMessageManager" p:store-ref="jpwebdynamicformMessageManagerCache"/>
            </set>
        </property>
    </bean>

</beans>
